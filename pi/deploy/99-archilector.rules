# ArchiLector · nombre fijo para el puerto del ESP32 (Documento Técnico 6.4, prueba T5.2)
# Así el software no depende de si aparece como ttyUSB0 o ttyUSB1.
# Instalar en /etc/udev/rules.d/ y ejecutar: sudo udevadm control --reload && sudo udevadm trigger

# DevKit con puente CP2102
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", SYMLINK+="archilector-esp32", GROUP="dialout", MODE="0660"
# DevKit con puente CH340
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", SYMLINK+="archilector-esp32", GROUP="dialout", MODE="0660"
