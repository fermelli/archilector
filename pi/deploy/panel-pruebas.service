[Unit]
# Panel de pruebas (cámara en vivo, OCR, voz): solo red local, sin autenticación.
# Usa la webcam para no quitarle la cámara CSI al servicio archilector.
# Se instala igual que archilector.service, cambiando usuario y carpeta (ver deploy/instalar.sh).
Description=ArchiLector - panel de pruebas (puerto 8889)
After=network.target sound.target

[Service]
Type=simple
User=archilector
Group=archilector
SupplementaryGroups=video audio
WorkingDirectory=/home/archilector/ArchiLector/pi
# Sin webcam no arranca (ni se reintenta): enchúfela y haga «sudo systemctl start panel-pruebas».
ExecCondition=/bin/sh -c 'ls /dev/v4l/by-id/usb-*-video-index0'
ExecStart=/home/archilector/ArchiLector/pi/.venv/bin/python herramientas/panel_pruebas.py --camara webcam
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1
# Pocas zonas de memoria por hilo: sin esto el proceso crecía hasta colgar la Pi de 2 GB
Environment=MALLOC_ARENA_MAX=2
# Si aun así se pasa, se reinicia solo el panel y no se cuelga toda la Pi
MemoryHigh=600M
MemoryMax=800M

[Install]
WantedBy=multi-user.target
